# Copiar a .env y ajustar. Todas son opcionales: estos son los valores por defecto.

# Paso 1 · OCR
OCR_DPI=300
OCR_IDIOMA=spa
OCR_PSM=3
# OCR_HILOS=3
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Paso 2 · Umbrales para marcar páginas mal leídas (también se pueden pasar a `main.py marcar`)
UMBRAL_CONF_MEDIA=0.70
UMBRAL_FRAC_BAJA=0.30
UMBRAL_FRAC_RARA=0.25
UMBRAL_MIN_PALABRAS=15
CONF_PALABRA_BAJA=0.60
TINTA_MIN=0.005

# Paso 3 · Modelo de visión
VLM_MODELO=Qwen/Qwen2-VL-2B-Instruct
VLM_DPI=200
VLM_MAX_PIXELS=1003520
VLM_MAX_TOKENS=2048

# Documento único · LLM vía OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Cadena de modelos: primero los gratuitos (en orden) y, si se agotan o fallan, los de pago hasta el tope de gasto
LLM_MODELOS_GRATIS=poolside/laguna-s-2.1:free,nvidia/nemotron-3-ultra-550b-a55b:free,dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free
LLM_MODELOS_PAGO=google/gemini-2.5-flash-lite,deepseek/deepseek-chat-v3.1
LLM_TOPE_USD=2.0
# si: con crédito, primero los modelos de pago
LLM_PAGO_PRIMERO=no
LLM_RPM=20

# Clasificación de fragmentos (vincular) y respuestas RAG (consultar): modelos baratos, sin razonamiento
LLM_MODELOS_CLASIFICAR=qwen/qwen3.7-flash,deepseek/deepseek-chat-v3.1
LLM_MODELOS_RAG=qwen/qwen3.7-flash,deepseek/deepseek-chat-v3.1
# Embeddings (OpenRouter /api/v1/embeddings); cambiar el modelo obliga a vectorizar de nuevo
EMBEDDINGS_MODELO=baai/bge-m3
