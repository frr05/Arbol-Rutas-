{"documento": "RITP.D09", "archivo": "4_modificacion_obras_convenios/Res-1569.pdf", "lineas": [{"i": 0, "pag": 1, "texto": "RECIBIDO", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 1, "pag": 1, "texto": "SECRETARIA", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 2, "pag": 1, "texto": "22 JUL. 2005", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 3, "pag": 1, "texto": "COORD. ADM. CONTRATOS", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 4, "pag": 1, "texto": "REPUBLICA DE CHILE", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 5, "pag": 1, "texto": "MINISTERIO DE OBRAS PUBLICAS", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 6, "pag": 1, "texto": "DIRECCION GENERAL DE OBRAS PUBLICAS", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 7, "pag": 1, "texto": "MINISTERIO DE HACIENDA", "conf": null, "fuente": "vlm", "parrafo": 2, "marginal": false}, {"i": 8, "pag": 1, "texto": "OFICINA DE PARTES", "conf": null, "fuente": "vlm", "parrafo": 2, "marginal": false}, {"i": 9, "pag": 1, "texto": "31 MAY 2005", "conf": null, "fuente": "vlm", "parrafo": 2, "marginal": false}, {"i": 10, "pag": 1, "texto": "RECIBIDO", "conf": null, "fuente": "vlm", "parrafo": 2, "marginal": false}, {"i": 11, "pag": 1, "texto": "Ref.: Excluye por razones de interés", "conf": null, "fuente": "vlm", "parrafo": 3, "marginal": false}, {"i": 12, "pag": 1, "texto": "público y urgencia la obra que", "conf": null, "fuente": "vlm", "parrafo": 3, "marginal": false}, {"i": 13, "pag": 1, "texto": "indica correspondientes a la obra", "conf": null, "fuente": "vlm", "parrafo": 3, "marginal": false}, {"i": 14, "pag": 1, "texto": "pública concesionada denominada", "conf": null, "fuente": "vlm", "parrafo": 3, "marginal": false}, {"i": 15, "pag": 1, "texto": "\"Ruta Interportuaria Talcahuano", "conf": null, "fuente": "vlm", "parrafo": 3, "marginal": false}, {"i": 16, "pag": 1, "texto": "- Penco por Isla Rocuant.\"", "conf": null, "fuente": "vlm", "parrafo": 3, "marginal": false}, {"i": 17, "pag": 1, "texto": "CONTRALORIA GENERAL", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 18, "pag": 1, "texto": "TOMA DE RAZON", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 19, "pag": 1, "texto": "RECEPCION", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 20, "pag": 1, "texto": "SANTIAGO, 26 MAYO 2005", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 21, "pag": 1, "texto": "VISTOS: - El DFL MOP N° 850 de 1997, que", "conf": null, "fuente": "vlm", "parrafo": 5, "marginal": false}, {"i": 22, "pag": 1, "texto": "fijó el texto refundido, coordinado", "conf": null, "fuente": "vlm", "parrafo": 5, "marginal": false}, {"i": 23, "pag": 1, "texto": "y sistematizado de la Ley N°", "conf": null, "fuente": "vlm", "parrafo": 5, "marginal": false}, {"i": 24, "pag": 1, "texto": "15.840, de 1964, Orgánica del", "conf": null, "fuente": "vlm", "parrafo": 5, "marginal": false}, {"i": 25, "pag": 1, "texto": "Ministerio de Obras Públicas y del", "conf": null, "fuente": "vlm", "parrafo": 5, "marginal": false}, {"i": 26, "pag": 1, "texto": "DFL N° 206, de 1960, Ley de", "conf": null, "fuente": "vlm", "parrafo": 5, "marginal": false}, {"i": 27, "pag": 1, "texto": "Caminos.", "conf": null, "fuente": "vlm", "parrafo": 5, "marginal": false}, {"i": 28, "pag": 1, "texto": "DEPART. JURIDICO |  |", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 29, "pag": 1, "texto": "DEP. T. R. Y REGISTRO |  |", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 30, "pag": 1, "texto": "DEPART. CONTABIL. |  |", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 31, "pag": 1, "texto": "SUB. DEP. C. CENTRAL |  |", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 32, "pag": 1, "texto": "SUB. DEP. E.